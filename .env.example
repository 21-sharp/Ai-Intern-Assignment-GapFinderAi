# Optional: enables Groq-backed grounded question generation and explanations.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Admin roster access. Set these in .env.local or your deployment environment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret

# Optional: defaults to ./data/gapfinder.sqlite
GAPFINDER_DB_PATH=
